{
  "policy": "best_effort",
  "endpoint_list": [
    {
      "name": "px4_serial",
      "type": "SerialByteTransport",
      "config": {
        "device_path": "/dev/ttyUSB0",
        "baud_rate": "115200"
      },
      "connect_on_create": true
    }
  ],
  "agent_list": [
    {
      "name": "heartbeat",
      "type": "heartbeat_generator",
      "config": {
        "heartbeat_freq": "1"
      },
      "start_on_create": true
    },
    {
      "name": "gz_bridge",
      "type": "gz_agent",
      "config": {
        "vehicle_name": "iris",
        "world_name": "default",
        "mavlink_endpoint_name": "px4_serial",
        "use_topic_generator": "true",
        "send_freq": "250"
      },
      "start_on_create": true
    }
  ]
}
